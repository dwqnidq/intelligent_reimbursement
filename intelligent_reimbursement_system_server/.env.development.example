NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://localhost:27017/Reimbursement
JWT_SECRET=your_dev_jwt_secret
JWT_EXPIRES_IN=7d
QINIU_ACCESS_KEY=your_dev_access_key
QINIU_SECRET_KEY=your_dev_secret_key
QINIU_BUCKET=your_dev_bucket
QINIU_DOMAIN=https://your-dev-cdn-domain
GRPC_HOST=127.0.0.1
GRPC_PORT=50051
FEISHU_APP_ID=your_dev_feishu_app_id
FEISHU_APP_SECRET=your_dev_feishu_app_secret
FEISHU_REDIRECT_URI=http://localhost:3000/api/users/auth/feishu
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
FEISHU_VERIFICATION_TOKEN=your_feishu_verification_token
FEISHU_ENCRYPT_KEY=
FEISHU_BOT_ENABLED=true
# websocket=长连接（无需公网域名）；webhook=HTTP 回调（需 HTTPS 公网地址）
FEISHU_BOT_MODE=websocket
# 连续发多个单文件时的汇总等待时间（毫秒），默认 500；仅 zip 或已有确认卡时不受此延迟
# FEISHU_BATCH_COLLECT_MS=500
# 可识别文件数量上限，0 或不填表示不限制（zip 内 + 散文件合计）
# FEISHU_MAX_RECOGNIZABLE_FILES=0
# 单文件大小上限（字节），默认 20MB
# FEISHU_MAX_FILE_BYTES=20971520
# 单个 zip 解压后总大小上限（字节），默认 100MB（与飞书下载限制一致）
# FEISHU_MAX_ZIP_TOTAL_BYTES=104857600


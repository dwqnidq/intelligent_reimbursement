# ===========================================
# 环境变量模板（所有可配置项）
# 开发环境: cp .env.dev .env
# 生产环境: cp .env.prod .env
# ===========================================

# 豆包大模型配置（使用 OpenAI 兼容格式）
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=doubao-seed-2-0-pro-260215

# MongoDB
MONGODB_URI=
# 若 URI 里没有 /数据库名 段，可填此项
# MONGODB_DB_NAME=Reimbursement

# 服务器配置
SERVER_HOST=0.0.0.0
SERVER_PORT=50051
MAX_WORKERS=10

# 日志配置
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# gRPC 配置
GRPC_MAX_MESSAGE_LENGTH=104857600

# OCR 并行进程数（默认 2，上限 3；设为 1 则主进程串行）
# OCR_MAX_PARALLEL=2

# ===========================================
# 生产环境配置
# 使用方式: cp .env.prod .env
# ===========================================

# 豆包大模型配置（使用 OpenAI 兼容格式）
ARK_API_KEY=your_production_ark_api_key_here
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=doubao-seed-2-0-pro-260215

# MongoDB（生产环境请使用实际的数据库地址）
MONGODB_URI=mongodb://your_mongo_host:27017/Reimbursement
# 若 URI 里没有 /数据库名 段，可填此项
# MONGODB_DB_NAME=Reimbursement

# 服务器配置
SERVER_HOST=0.0.0.0
SERVER_PORT=50051
MAX_WORKERS=10

# 日志配置
LOG_LEVEL=WARNING
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# gRPC 配置
GRPC_MAX_MESSAGE_LENGTH=104857600
